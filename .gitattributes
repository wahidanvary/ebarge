# Normalize text files and keep repository line endings consistent

* text=auto eol=lf

# Windows command files

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jks binary
*.keystore binary
*.jar binary
*.zip binary
